# Nexa Paraguay — environment variables
# Copy into CI/CD secrets. Never commit real values.

NEXT_PUBLIC_APP_URL=https://nexa.paragu-ai.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_PROJECT_REF=<project-ref>

# Analytics (GA4)
NEXT_PUBLIC_GA4_ID=G-XE49GLEP34

# CRM (HubSpot forms API)
CRM_PORTAL_ID=<hubspot-portal-id>
CRM_ENDPOINT=<hubspot-form-guid>

# Email (Mailchimp)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=<mailchimp-list-id>
EMAIL_FROM_ADDRESS=hola@nexaparaguay.com
EMAIL_FROM_NAME=Nexa Paraguay

# Transactional email (optional)
EMAIL_TRANSACTIONAL_KEY=
